# Copia este archivo como ".env" (en la misma carpeta) y complétalo.
# El archivo .env NO se sube a git.

# Permite usar "docker compose up -d --build" sin indicar el archivo.
COMPOSE_FILE=docker-compose.prod.yml

# Contraseña de la base de datos (inventa una larga; no uses 1234).
DB_PASSWORD=

# Secreto con el que se firman las sesiones. 32 caracteres o más, al azar.
# Ejemplo para generarlo en PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# Puerto por el que se abre la aplicación (80 = http://servidor/).
APP_PORT=80
